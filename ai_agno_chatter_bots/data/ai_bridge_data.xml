<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        auth_token is intentionally left empty. Set ICP
        ai_agno_chatter_bots.bridge_auth_token before install, or paste
        BRIDGE_AUTH_TOKEN on each bridge after install.
    -->

    <record id="ai_bridge_chatter_erp" model="ai.bridge">
        <field name="name">Agno Chatter ERP</field>
        <field name="description">
            <![CDATA[
            <p>Discuss bot for ERP data questions (Agno <tt>erp</tt> persona).</p>
            ]]>
        </field>
        <field name="usage">chatter</field>
        <field name="payload_type">chatter</field>
        <field name="result_type">message</field>
        <field name="result_kind">immediate</field>
        <field name="auth_type">token</field>
        <field name="provider">agno</field>
        <field name="request_timeout" eval="120" />
        <field name="url">http://agno:8000/bridge/chatter/erp</field>
    </record>

