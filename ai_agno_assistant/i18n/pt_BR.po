#. module: ai_agno_assistant
#: model:res.groups,comment:ai_agno_assistant.group_system_ai_user
msgid ""
"\n"
"            Allow using the global AI assistant to query ERP data, open\n"
"            screens/menus, and prepare draft business records for review\n"
"            (RFQ, opportunity, helpdesk ticket, quotation, timesheet).\n"
"        "
msgstr ""
"\n"
"            Permite usar o assistente de IA global para consultar dados do "
"ERP, abrir telas/menus e preparar registros comerciais em rascunho para "
"revisão (RFQ, oportunidade, chamado de helpdesk, cotação, apontamento de "
"horas).\n"
"        "

