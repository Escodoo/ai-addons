<templates xml:space="preserve">
    <t t-name="ai_agno_assistant.Systray">
        <div class="o_ai_assistant_systray o-dropdown dropdown">
            <a
                class="dropdown-toggle o-no-caret o-dropdown--narrow"
                href="#"
                title="System AI Assistant"
                t-on-click.prevent="togglePanel"
            >
                <i
                    class="fa fa-comments-o fa-lg"
                    role="img"
                    aria-label="System AI Assistant"
                />
            </a>
            <div
                t-if="state.panelOpen"
                class="o_ai_assistant_panel border bg-view d-flex flex-column shadow"
                role="complementary"
                aria-label="System assistant"
                t-ref="panel"
                t-on-click.stop="onPanelClick"
            >
                <div
                    class="o_ai_assistant_panel_header d-flex align-items-center gap-2 px-3 py-2 border-bottom"
                >
                    <h6 class="mb-0 text-truncate flex-grow-1">System assistant</h6>
                    <button
                        class="btn btn-sm btn-light"
                        title="New conversation"
                        t-att-disabled="state.loading"
                        t-on-click="startNewSession"
                    >
                        <i class="fa fa-plus" role="img" aria-label="New" />
                    </button>
                    <button
                        class="btn btn-sm btn-light"
                        title="Delete conversation"
                        t-att-disabled="!canClearChat"
                        t-on-click="deleteConversation"
                    >
                        <i class="fa fa-trash-o" role="img" aria-label="Delete" />
                    </button>
                    <button
                        class="btn btn-sm btn-light"
                        title="Copy to clipboard"
                        t-att-disabled="!canCopyBody"
                        t-on-click="copyBody"
                    >
                        <i class="fa fa-clipboard" role="img" aria-label="Copy" />
                    </button>
                    <button
                        class="btn btn-sm btn-light"
                        title="Close"
                        t-on-click="closePanel"
                    >
                        <i class="fa fa-times" role="img" aria-label="Close" />
                    </button>
                </div>
                <div
                    t-if="state.sessions.length"
                    class="o_ai_assistant_sessions px-3 py-1 border-bottom"
                >
                    <select
                        class="form-select form-select-sm"
                        t-on-change="onSelectSession"
                    >
                        <option value="">Recent conversations</option>
                        <t t-foreach="state.sessions" t-as="session" t-key="session.id">
                            <option
                                t-att-value="session.session_key"
                                t-att-selected="session.session_key === state.sessionKey"
                            >
                                <t t-esc="session.name" />
                            </option>
                        </t>
                    </select>
                </div>
                <div
                    class="o_ai_assistant_panel_body flex-grow-1 overflow-auto p-3 d-flex flex-column gap-2"
                    t-ref="panelBody"
                >
                    <div
                        t-if="!state.messages.length and !state.loading"
                        class="o_ai_assistant_empty"
                    >
                        <div class="text-muted small mb-2">
                            Ask about ERP data, open screens, prepare a draft, or
                            export a briefing from a message.
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            <t
                                t-foreach="suggestions"
                                t-as="suggestion"
                                t-key="suggestion.prompt"
                            >
                                <button
                                    class="btn btn-sm btn-outline-secondary o_ai_assistant_suggestion"
                                    t-on-click="() => this.useSuggestion(suggestion.prompt)"
                                >
                                    <t t-esc="suggestion.label" />
                                </button>
                            </t>
                        </div>
                    </div>
                    <t t-foreach="state.messages" t-as="message" t-key="message.id">
                        <div
                            class="o_ai_assistant_message"
                            t-att-class="message.role === 'user' ? 'o_ai_assistant_message_user' : 'o_ai_assistant_message_assistant'"
                        >
                            <div
                                class="o_ai_assistant_message_role small mb-1 d-flex align-items-center gap-1"
                            >
                                <span class="flex-grow-1">
                                    <t t-if="message.role === 'user'">You</t>
                                    <t t-else="">AI</t>
                                </span>
                                <button
                                    t-if="message.role === 'assistant'"
                                    class="btn btn-sm btn-light o_ai_assistant_message_copy"
                                    title="Copy to clipboard"
                                    t-on-click="() => this.copyMessage(message)"
                                >
                                    <i
                                        class="fa fa-clipboard"
                                        role="img"
                                        aria-label="Copy"
                                    />
                                </button>
                                <button
                                    t-if="message.role === 'assistant'"
                                    class="btn btn-sm btn-light o_ai_assistant_message_export_md"
                                    title="Export Markdown"
                                    t-on-click="() => this.exportMessageMarkdown(message)"
                                >
                                    <i
                                        class="fa fa-file-text-o"
                                        role="img"
                                        aria-label="Export Markdown"
                                    />
                                </button>
                                <button
                                    t-if="message.role === 'assistant'"
                                    class="btn btn-sm btn-light o_ai_assistant_message_export_pdf"
                                    title="Export PDF"
                                    t-on-click="() => this.exportMessagePdf(message)"
                                >
                                    <i
                                        class="fa fa-file-pdf-o"
                                        role="img"
                                        aria-label="Export PDF"
                                    />
                                </button>
                            </div>
                            <div
                                t-if="message.isHtml"
                                class="o_ai_assistant_content"
                                t-out="message.html"
                            />
                            <div
                                t-else=""
                                class="o_ai_assistant_content"
                                t-esc="message.text"
                            />
                            <div
                                t-if="message.actions.length"
                                class="o_ai_assistant_chips d-flex flex-wrap gap-1 mt-2"
                            >
                                <t
                                    t-foreach="message.actions"
                                    t-as="chip"
                                    t-key="chip_index"
                                >
                                    <t t-if="chip.type === 'confirm_pending'">
                                        <button
                                            class="btn btn-sm btn-primary o_ai_assistant_message_action"
                                            t-att-disabled="state.loading"
                                            t-on-click="() => this.confirmPending(true)"
                                        >
                                            <t t-esc="actionLabel(chip)" />
                                        </button>
                                        <button
                                            class="btn btn-sm btn-light"
                                            t-att-disabled="state.loading"
                                            t-on-click="() => this.confirmPending(false)"
                                        >
                                            Cancel
                                        </button>
                                    </t>
                                    <button
                                        t-else=""
                                        class="btn btn-sm btn-outline-primary o_ai_assistant_message_action"
                                        t-on-click="() => this.runChipAction(chip)"
                                    >
                                        <t t-esc="actionLabel(chip)" />
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>
                    <div
                        t-if="state.loading"
                        class="d-flex align-items-center justify-content-center text-muted py-3 gap-2"
                    >
                        <i
                            class="fa fa-circle-o-notch fa-spin fa-lg"
                            role="img"
                            aria-label="Loading"
                        />
                        <span class="small" t-esc="state.statusText" />
                        <button
                            class="btn btn-sm btn-link"
                            t-on-click="cancelRequest"
                        >Cancel</button>
                    </div>
                </div>
                <div class="o_ai_assistant_composer border-top p-2">
                    <div class="input-group input-group-sm">
                        <textarea
                            class="form-control o_ai_assistant_input"
                            rows="2"
                            placeholder="Ask the system assistant…"
                            t-att-disabled="state.loading"
                            t-model="state.draft"
                            t-ref="draftInput"
                            t-on-keydown="onDraftKeydown"
                        />
                        <button
                            class="btn btn-primary"
                            title="Send"
                            t-att-disabled="!canSend"
                            t-on-click="sendMessage"
                        >
                            <i class="fa fa-paper-plane" role="img" aria-label="Send" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
