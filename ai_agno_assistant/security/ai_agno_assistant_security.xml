<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_system_ai" model="ir.module.category">
        <field name="name">System AI Assistant</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_system_ai_user" model="res.groups">
        <field name="name">Use System AI Assistant</field>
        <field name="category_id" ref="module_category_system_ai" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="comment">
            Allow using the global AI assistant to query ERP data, open
            screens/menus, and prepare draft business records for review
            (RFQ, opportunity, helpdesk ticket, quotation, timesheet).
        </field>
    </record>
</odoo>
