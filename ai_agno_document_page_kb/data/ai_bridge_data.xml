<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        auth_token is intentionally left empty. Set ICP
        ai_agno_document_page_kb.bridge_auth_token before install, or paste
        BRIDGE_AUTH_TOKEN on each bridge after install.

        domain and field_ids are stored computed fields on ai.bridge; the
        post_init_hook rewrites them and upserts matching content pages.
    -->

    <!-- Support KB (customer helpdesk content) -->
    <record id="ai_bridge_support_create" model="ai.bridge">
        <field name="name">Document Page → Support KB (Create)</field>
        <field name="description">
            <![CDATA[
            <p>Indexes new document pages tagged <b>support</b> into the Agno support knowledge base.</p>
            ]]>
        </field>
        <field name="model_id" ref="document_page.model_document_page" />
        <field name="usage">ai_thread_create</field>
        <field name="url">http://agno:8000/bridge/kb/support/upsert</field>
        <field name="auth_type">token</field>
        <field name="payload_type">record</field>
        <field name="result_type">none</field>
        <field name="result_kind">immediate</field>
    </record>

    <record id="ai_bridge_support_write" model="ai.bridge">
        <field name="name">Document Page → Support KB (Update)</field>
        <field name="description">
            <![CDATA[
            <p>Re-indexes updated document pages tagged <b>support</b> in the Agno support knowledge base.</p>
            ]]>
        </field>
        <field name="model_id" ref="document_page.model_document_page" />
        <field name="usage">ai_thread_write</field>
        <field name="url">http://agno:8000/bridge/kb/support/upsert</field>
        <field name="auth_type">token</field>
        <field name="payload_type">record</field>
        <field name="result_type">none</field>
        <field name="result_kind">immediate</field>
    </record>

    <record id="ai_bridge_support_unlink" model="ai.bridge">
        <field name="name">Document Page → Support KB (Delete)</field>
        <field name="description">
            <![CDATA[
            <p>Removes deleted document pages tagged <b>support</b> from the Agno support knowledge base.</p>
            ]]>
        </field>
        <field name="model_id" ref="document_page.model_document_page" />
        <field name="usage">ai_thread_unlink</field>
        <field name="url">http://agno:8000/bridge/kb/support/delete</field>
        <field name="auth_type">token</field>
        <field name="payload_type">none</field>
        <field name="result_type">none</field>
        <field name="result_kind">immediate</field>
    </record>

